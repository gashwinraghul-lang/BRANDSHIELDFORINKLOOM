{
  "name": "brandshield",
  "private": true,
  "workspaces": ["client", "server", "agent"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace client\" \"npm run dev --workspace server\" \"npm run dev --workspace agent\"",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace client && npm run test --workspace server",
    "start": "node server/src/index.js",
    "migrate": "node server/scripts/migrate.js",
    "seed": "node server/scripts/seed.js",
    "eval:claims": "node server/scripts/evalClaims.js",
    "eval:images": "node server/scripts/evalImages.js",
    "agent": "python -m agent.agent"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
