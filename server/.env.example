# Server environment variables
# Copy this file to .env and fill in the values

# MySQL connection (Docker service "db" provides these defaults)
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=brandshield
MYSQL_USER=brandshield
MYSQL_PASSWORD=examplePass

# JWT secret (use a strong random string)
JWT_SECRET=your_jwt_secret_here

# JWT token expiry (in seconds) – access token short, refresh longer
JWT_ACCESS_EXPIRES=900
JWT_REFRESH_EXPIRES=604800

# Groq LLM configuration (free tier – get key at https://console.groq.com)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# SMTP configuration for email verification and password reset (Ethereal for dev)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user
SMTP_PASS=your_ethereal_pass

# Rate limiting configuration
RATE_LIMIT_MAX=200

# CSRF protection (leave default)
CSRF_SECRET=your_csrf_secret

# Agentverse integration token (shared secret between server and uAgent)
AGENT_SERVICE_TOKEN=your_agent_service_token
