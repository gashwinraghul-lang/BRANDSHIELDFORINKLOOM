# Root environment variables for Docker services
# Copy to .env and adjust if needed
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=brandshield
MYSQL_USER=brandshield
MYSQL_PASSWORD=examplePass
JWT_SECRET=supersecretkey123
JWT_ACCESS_EXPIRES=900
JWT_REFRESH_EXPIRES=604800
GROQ_API_KEY=PLACEHOLDER_GROQ_KEY
GROQ_MODEL=llama-3.3-70b-versatile
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=PLACEHOLDER_ETHEREAL_USER
SMTP_PASS=PLACEHOLDER_ETHEREAL_PASS
RATE_LIMIT_MAX=200
CSRF_SECRET=PLACEHOLDER_CSRF_SECRET
AGENT_SERVICE_TOKEN=PLACEHOLDER_AGENT_TOKEN
